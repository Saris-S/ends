          EmotionName: Talk
          Action: 0
          PosX: 420
          PosY: 0
          Zoom: 1
        DialogsText:
        - LanguageCode: en
          SayerName: Guard
          Text: Ambition smells like onions you forgot, Pip. And don't call me Crumb
