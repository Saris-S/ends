          PosY: -340
          Zoom: 0.36
        DialogsText:
        - LanguageCode: en
          SayerName: Chef
          Text: Oi, Crumb - sniff that? That ain't the stew. That's ambition burnin'
            on the pan.
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: Chef
          Text: "\xA1Eh, Crumb! \xBFHueles eso? No es el guiso. Es la ambici\xF3n
            quem\xE1ndose en la sart\xE9n."
          VoiceClip: {fileID: 0}
